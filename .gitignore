# ============================================================
# Dungeon2 — корневой .gitignore
# Правила: кладём в git исходники и рабочие ассеты проекта,
# не кладём скачиваемое, стороннее, производное и кэш.
# ============================================================

# --- Godot ---
# Кэш импорта и редактора (дублирует game/.gitignore — не мешает)
.godot/
# Сгенерированные переводы
*.translation
# Экспорт-шум (сами пресеты экспорта храним, они не создаются здесь)
export.cfg
*.tmp

# --- Движок (бинарники скачиваем отдельно) ---
/Godot/

# --- Сторонний арт: паки не редактируем, не храним в git ---
/art/Dungeon Pack/
/art/KayKit_Character_Animations_1.1/
/art/KayKit_Dungeon_Pack_1.1_FREE/
# Сырьё до даунскейла: работаем с art/models/*_1024.glb
/art/models/original/

# --- Вложенные git-клоны и локальные скиллы opencode ---
/.opencode/
/skills/superpowers/

# --- Временные пробы задач ---
# docs/current/<задача>/temp/ — логи прогонов и рендеры-проверки (constraints.md §2).
# Удаляются вместе с задачей, в историю репозитория не попадают.
/docs/current/*/temp/

# --- Blender ---
# Резервные копии *.blend1; сами .blend трекаем как исходники
*.blend1

# --- Python ---
# Байткод проб blender -b --python и вспомогательных скриптов (находка T2r-a2)
__pycache__/

# --- Локальные скрипты запуска (машинозависимые) ---
/open_editor.bat
/start_game.bat

# --- Секреты: значения ключей только локально ---
/skills/agnes-image-gen/api-key.md

# --- Логи и мусор приложений ---
*.log

# --- ОС и редакторы ---
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/
