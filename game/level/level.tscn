[node name="GridCollision" type="Node" parent="." unique_id=1100000211]
script = ExtResource("29_gridcol")

; Зона входа (T6). Место выбрано пробой по данным GridCollision, растёртым в растр
; 0.25 м (temp/T6-23-freespace-fine.log): 387 подходящих начал, выбрано (100, 12).
;   - пятно блока породы x 92..116, z 4..20 (24 x 16 м) не задевает ни одной коробки
;     стен GridCollision и ни одного тела Module_* (мебель уровня);
;   - под всем пятном есть плита пола GridMapFloor;
;   - старт игрока (66, 2.05, 34) вне пятна;
;   - проём коридора смотрит на -X (мировой x = 92), перед ним 6 м свободного пола
;     пещеры (x 86..92, z 10..14), по нему герой подходит от старта;
;   - двор (локально x 7..15 -> мир 107..115) остаётся внутри породы: блок
;     x -8..+16, двор вырезан в нём ямой (design.md:65-67). От края пола пещеры
;     (x ~135.8) двор отделён 20 м — там потом пандус на поверхность, он вне задачи.
; Ось зоны не повернута: поворот на 180° повернул бы проём к краю пещеры, где
; герою неоткуда подойти.
; y = 2.06 — на 1 см выше верха плиты пола уровня (2.05): при y = 2.05 пол зоны и
; плита пола уровня лежали бы в одной плоскости (z-бой по всему залу и двору).
[node name="GateEntrance" parent="." instance=ExtResource("31_gate")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 100, 2.06, 12)
