extends AnimatableBody3D

# Решётка ворот (T3). Механика подъёма: единственный интерфейс — open() и is_open(),
# рычаг (T4) будет вызывать open().
#
# Почему AnimatableBody3D, а не Node3D: тело, которым «перевозят» персонажа, должно быть
# телом физики — иначе поднятая решётка остаётся для игрока декорацией. sync_to_physics
# выставлен в сцене: тело едет по вертикали, и физика должна видеть это движение
# (персонаж под решёткой уезжает вместе с ней, а не проваливается внутрь).

## Собственная высота подъёма, НЕ высота проёма (решение пользователя 13.10.2026):
## нижняя часть решётки уходит в нишу над проёмом, проход остаётся открытым для капсулы 1.8 м.
@export var open_height := 3.5
## Длительность подъёма, секунды. Tween идёт в физических кадрах — под sync_to_physics
## тело должно двигаться вместе с физикой, иначе связка тело-физика дёргается на кадрах.
@export var open_time := 1.0

const POSITION_EPS := 0.0001

var _closed_y := 0.0
var _tween: Tween = null


func _ready() -> void:
	_closed_y = position.y


## Поднять решётку на open_height от закрытого положения.
## Повторный вызов, пока подъём уже идёт или завершён, ИГНОРИРУЕТСЯ: решётка — односторонний
## лифт, второй вызов не перезапускает анимацию и не накапливает position.y.
func open() -> void:
	if _tween != null and _tween.is_valid():
		return
	if is_open():
		return
	_tween = create_tween()
	_tween.set_process_mode(Tween.TWEEN_PROCESS_PHYSICS)
	_tween.tween_property(self, "position:y", _closed_y + open_height, open_time)


## Поднята ли решётка (низ меша дошёл до цели). Считается от позиции, а не от флага:
## состояние восстанавливается из положения узла, тест в том числе этим пользуется.
func is_open() -> bool:
	return position.y >= _closed_y + open_height - POSITION_EPS